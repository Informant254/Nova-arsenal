# Nova-Arsenal Environment Variables
# Copy to project root as `.env` (or `config/.env`) and fill in keys you have.
#
# Bring-your-own-key (BYOK): set ANY of the provider keys below. Nova auto-detects
# them and routes the agent/chat through your subscription. No vendor lock-in.
#
# Prefer a provider:
#   export LLM_PROVIDER=openai
#   export LLM_MODEL=gpt-5.6-terra
# Or use OpenRouter with one key for many models:
#   export LLM_PROVIDER=openrouter
#   export OPENROUTER_API_KEY=sk-or-...

# ── Cloud LLM API keys (set the ones you subscribe to) ──────────────────────
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-terra

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

GOOGLE_API_KEY=
# GEMINI_API_KEY=          # alias for GOOGLE_API_KEY
# GEMINI_MODEL=gemini-3.8-flash

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/auto

DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

DASHSCOPE_API_KEY=
# QWEN_API_KEY=            # alias
# QWEN_MODEL=qwen3.8-flash

HUGGINGFACE_API_KEY=
# HF_TOKEN=                # alias
# HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

OPCODE_API_KEY=
# OPENCODE_API_KEY=        # alias

# ── Choose primary provider (optional) ─────────────────────────────────────
# openai | anthropic | gemini | openrouter | deepseek | qwen | huggingface | ollama | opencode | local
LLM_PROVIDER=
LLM_MODEL=

# ChatGPT / Codex subscription OAuth (optional override of default client id)
# OPENAI_CODEX_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
# NOVA_CODEX_CALLBACK_PORT=1455
# NOVA_CODEX_DEVICE_CODE=false
# Aliases also accepted:
# NOVA_LLM_PROVIDER=
# NOVA_LLM_MODEL=

# ── Local Ollama (free, no key) ────────────────────────────────────────────
NOVA_LLM_URL=http://localhost:11434
# OLLAMA_MODEL=deepseek-r1

# ── Authentication (Nova platform users, not LLM keys) ─────────────────────
# Generate a long random value before deployment.
JWT_SECRET=

# Optional first administrator. If any NOVA_ADMIN_* setting is used, email and
# password are required; the password must be at least 12 characters.
NOVA_ADMIN_EMAIL=
NOVA_ADMIN_USERNAME=admin
NOVA_ADMIN_PASSWORD=

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///workspace/nova.db

# ── Agent ──────────────────────────────────────────────────────────────────
NOVA_WORKSPACE=/workspace
NOVA_MAX_STEPS=40
NOVA_PERMISSION_PROFILE=scoped
NOVA_CONFIG=config/settings.yaml

# ── Web UI ─────────────────────────────────────────────────────────────────
AGENT_API_URL=http://localhost:8000
# NOVA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Misc ───────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=nova-arsenal
DEBUG=false
LOG_LEVEL=INFO
