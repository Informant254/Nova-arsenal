FROM kalilinux/kali-rolling

WORKDIR /workspace

# Install the baseline toolset from Kali's own package repositories.
RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap \
    sqlmap \
    nikto \
    dirb \
    gobuster \
    hydra \
    john \
    hashcat \
    subfinder \
    nuclei \
    ffuf \
    httpx-toolkit \
    python3 \
    git \
    curl \
    wget \
    net-tools \
    dnsutils \
    whois \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -s /bin/bash agent
USER agent
WORKDIR /home/agent

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD nmap --version || exit 1

CMD ["/bin/bash"]
